    "Natural fill. Opens up shadows without looking flashed. A good default." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débouchage naturel. Éclaircit les ombres sans effet flash visible. Un bon réglage par défaut."
          }
        }
      }
    },
    "Needs %@ less than your lowest setting. Move back to %@ or stop down." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Needs %1$@ less than your lowest setting. Move back to %2$@ or stop down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut %1$@ de moins que votre réglage le plus faible. Reculez à %2$@ ou fermez le diaphragme."
          }
        }
      }
    },
    "Needs %@ more than full power. Move within %@, open the aperture, or use faster film." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Needs %1$@ more than full power. Move within %2$@, open the aperture, or use faster film."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut %1$@ de plus que la pleine puissance. Rapprochez-vous à moins de %2$@, ouvrez le diaphragme ou utilisez un film plus sensible."
          }
        }
      }
    },
