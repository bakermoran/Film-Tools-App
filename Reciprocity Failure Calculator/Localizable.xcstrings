    "Apertures past f/22 are smaller than most lenses go. Use an ND filter and open up one stop per stop of ND. The flash power stays the same." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de f/22, la plupart des objectifs ne ferment plus. Utilisez un filtre ND et ouvrez d'un IL par IL de ND. La puissance du flash ne change pas."
          }
        }
      }
    },
