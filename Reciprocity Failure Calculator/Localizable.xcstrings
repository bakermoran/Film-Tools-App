        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiers d'IL"
          }
        }
      }
    },
    "Times in seconds; 1/2 and 2m30s also work. Start with the longest time that needs no correction (same time on both sides), then add the manufacturer's rows." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps en secondes ; 1/2 et 2m30s fonctionnent aussi. Commencez par le temps le plus long qui ne demande aucune correction (même temps des deux côtés), puis ajoutez les lignes du fabricant."
          }
        }
      }
    },
